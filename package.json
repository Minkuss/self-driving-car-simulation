{
  "name": "autonomous-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.3",
    "npm": "11.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:simulator": "tsc --noEmit false --outDir .simulator-check && node .simulator-check/simulator/first-run.check.js",
    "check:traffic-light": "tsc --noEmit false --outDir .simulator-check && node .simulator-check/model/traffic-light-policy.check.js",
    "check:pedestrian": "tsc --noEmit false --outDir .simulator-check && node .simulator-check/model/pedestrian-policy.check.js",
    "generate:training": "tsc --noEmit false --outDir .simulator-check && node .simulator-check/simulator/export-training.js > training/examples.jsonl"
  },
  "dependencies": {
    "onnxruntime-web": "1.19.2"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "eslint": "9.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.10"
  }
}
